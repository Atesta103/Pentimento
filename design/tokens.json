{
  "_source": "Direction artistique « Terre » / identité Brume. Source unique : le CSS (src/styles/tokens.css) est généré d'ici par `node scripts/generate-tokens.ts`.",
  "_todo": [
    "motion.easing : courbes d'accélération inconnues, en attente de identity/brume.ts de l'ancien dépôt (valeurs provisoires nommées todo)",
    "font.files : fichiers Young Serif et Instrument Sans (OFL) à fournir par Alexandre ; police de repli utilisée en attendant",
    "logo : le nom « Pentimento » en texte Young Serif suffit pour la phase 2"
  ],
  "color": {
    "fond": "#F6F7F4",
    "texte": "#1F2A2E",
    "action": "#3E6B6A",
    "action-hover": "#2E5252",
    "surface": "#E4EBE6",
    "disabled-text": "#6B7678",
    "blanc": "#FFFFFF"
  },
  "state": {
    "erreur": {
      "primitives": ["brume-brique", "brume-brique-teinte"],
      "forte": "#A63D2B",
      "teinte": "#F6E1DA",
      "icone": "cercle + point d'exclamation"
    },
    "succes": {
      "primitives": ["brume-mousse", "brume-mousse-teinte"],
      "forte": "#41692B",
      "teinte": "#E3EDD9",
      "icone": "cercle + coche"
    },
    "attention": {
      "primitives": ["brume-ocre", "brume-ocre-teinte"],
      "forte": "#8A5A0B",
      "teinte": "#F6E8C8",
      "icone": "triangle + point d'exclamation"
    },
    "info": {
      "primitives": ["brume-ardoise-bleue", "brume-ardoise-bleue-teinte"],
      "forte": "#3D5F82",
      "teinte": "#E0E8F0",
      "icone": "cercle + i"
    }
  },
  "banner": {
    "border": "forte à 40 % d'opacité",
    "borderOpacityPercent": 40,
    "text": "texte",
    "title": "forte"
  },
  "font": {
    "heading": {
      "family": "Young Serif",
      "fallback": "Georgia, serif",
      "weight": 400,
      "note": "400 uniquement, jamais de gras"
    },
    "body": {
      "family": "Instrument Sans",
      "fallback": "system-ui, sans-serif",
      "weights": { "regular": 400, "caption": 500, "label": 600 }
    },
    "scale": {
      "display": { "size": 88, "line": 88 },
      "titre-1": { "size": 56, "line": 64 },
      "titre-2": { "size": 36, "line": 40 },
      "titre-3": { "size": 28, "line": 32 },
      "titre-4": { "size": 24, "line": 32 },
      "corps-grand": { "size": 20, "line": 28 },
      "corps": { "size": 16, "line": 24 },
      "legende": { "size": 16, "line": 24 }
    },
    "minSizePx": 16,
    "readingWidthCh": 62
  },
  "spacing": [4, 8, 12, 16, 24, 32, 48, 64, 96],
  "radius": { "8": "boutons, champs, bandeaux", "12": "cartes" },
  "shadow": "aucune",
  "focus": {
    "ring": { "widthPx": 4, "offsetPx": 4, "color": "action" },
    "note": "suit l'arrondi de l'élément ; remplace l'ancien 3 px blanc + 2 px action"
  },
  "disabled": {
    "background": "surface",
    "text": "disabled-text",
    "note": "exempté du niveau AA, gardé lisible"
  },
  "button": {
    "danger": { "background": "erreur.forte", "text": "blanc" },
    "action": { "background": "action", "hover": "action-hover", "text": "blanc" }
  },
  "motion": {
    "durationsMs": { "base": 320, "slow": 480 },
    "easing": { "todo-standard": "ease" },
    "reducedMotion": "aucune animation ni transition"
  },
  "contrast": {
    "minimum": 4.5,
    "checks_per_state": ["forte/fond", "forte/teinte", "blanc/forte", "texte/teinte"],
    "reference_ratios": {
      "erreur": { "forte/fond": 5.88, "forte/teinte": 5.02, "blanc/forte": 6.32, "texte/teinte": 11.69 },
      "succes": { "forte/fond": 5.95, "forte/teinte": 5.30, "blanc/forte": 6.40, "texte/teinte": 12.16 },
      "attention": { "forte/fond": 5.50, "forte/teinte": 4.87, "blanc/forte": 5.92, "texte/teinte": 12.10 },
      "info": { "forte/fond": 6.18, "forte/teinte": 5.37, "blanc/forte": 6.65, "texte/teinte": 11.88 }
    },
    "other_reference_ratios": {
      "action/fond": 5.55,
      "blanc/action": 5.97,
      "disabled-text/surface": 3.86
    }
  },
  "measure": {
    "rule": "espacements, arrondis, tailles, hauteurs de ligne et durées (ms) en multiples de 4",
    "exceptions": "traits de 1 à 2 px ; espacement des lettres (em)"
  }
}
